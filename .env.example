# ── Copy to .env and fill in. .env is git-ignored; never commit real tokens. ──

# GitHub Models API (GPT-4o) — used for AI LaTeX drafting (/api/generate)
GITHUB_TOKEN=your_github_models_token

# Path A — Overleaf native git bridge (requires Overleaf Professional/Premium)
# Project URL: Overleaf project → Menu → Git
# Token:       Account Settings → Git Integration → Generate token (olp_...)
OVERLEAF_PROJECT_URL=https://git.overleaf.com/your-project-id
OVERLEAF_GIT_TOKEN=olp_your_overleaf_git_token

# Path B — GitHub (Overleaf-synced mirror). Token needs 'repo' scope for push + PR.
GITHUB_DEMO_REPO=https://github.com/your-org/your-paper-repo.git
GITHUB_DEMO_TOKEN=ghp_your_github_pat_with_repo_scope

# Optional — local scratch dir for repo clones (default: C:\Users\<you>\overleaf-workspace)
# REPO_WORKSPACE_DIR=C:\path\to\workspace
